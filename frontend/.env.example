# Frontend (Vite) environment template.
#
# In dev, leave VITE_API_BASE_URL unset (or empty). The Vite proxy in
# vite.config.ts forwards `/runs/*` + `/config` to the FastAPI backend on
# localhost:8000, so relative paths just work.
#
# In production on Vercel, set this to the deployed backend's full origin
# (Render / Fly / etc.) — the client prefixes every request with it.

# Example for a Render-hosted backend:
# VITE_API_BASE_URL=https://modeltracex-api.onrender.com
