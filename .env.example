# ModelTraceX v2 — environment configuration template (NFR-10).
# Copy to `.env` and fill in. All vars are prefixed MODELTRACEX_ and map to
# fields on modeltracex.config.Settings. Secrets are read from the environment
# and are NEVER persisted to the run store.

# --- LLM provider selection (NFR-1) ---
MODELTRACEX_PROVIDER=anthropic          # anthropic | openai | azure_openai | local | fake
MODELTRACEX_MODEL=claude-sonnet-4-6     # cloud default; escalate hard models to claude-opus-4-7
MODELTRACEX_LOCAL_BASE_URL=http://localhost:11434/v1   # Ollama/vLLM OpenAI-compatible endpoint
MODELTRACEX_LOCAL_MODEL=qwen2.5-coder:32b

# --- Security & data handling (NFR-2) ---
MODELTRACEX_SECURITY_MODE=cloud         # cloud | local  (local = no-egress, enforced by the egress guard)
MODELTRACEX_RETAIN_SOURCE=false         # in local mode, do not persist source bodies unless true

# --- Orchestration (FR-3) ---
MODELTRACEX_MAX_CONCURRENCY=4
MODELTRACEX_REQUESTS_PER_MINUTE=60
MODELTRACEX_TOKENS_PER_MINUTE=120000

# --- Analysis defaults ---
MODELTRACEX_DETAIL_LEVEL=table          # table | column
# Comma-separated list, parsed into a list[str]:
MODELTRACEX_OUTPUT_FORMATS=["docx","xlsx"]

# --- Provider secrets (leave blank when unused; never committed) ---
MODELTRACEX_ANTHROPIC_API_KEY=
MODELTRACEX_OPENAI_API_KEY=
MODELTRACEX_AZURE_OPENAI_API_KEY=
MODELTRACEX_AZURE_OPENAI_ENDPOINT=

# --- Store ---
MODELTRACEX_DB_PATH=modeltracex.db
