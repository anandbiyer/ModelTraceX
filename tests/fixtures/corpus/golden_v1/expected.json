      {"source": "lib.transactions", "target": "work.base"},
      {"source": "work.base", "target": "work.summary"},
      {"source": "work.summary", "target": "report.final"}
    ]
  },
  "v2_improvements": {
    "usages": [
      {"element": "lib.transactions.cost", "usage_kind": "denominator"},
      {"element": "lib.transactions.amount", "usage_kind": "range_filter"},
      {"element": "work.base.region", "usage_kind": "aggregated"}
    ],
    "table_roles": {
      "lib.transactions": "Source",
      "work.base": "Intermediate",
      "work.summary": "Intermediate",
      "report.final": "Output"
    }
  }
